# Sem DATABASE_URL a aplicação sobe em modo demonstração: estado em memória,
# snapshot em disco e o aviso no topo das telas. Com DATABASE_URL, identidade,
# cadastro de pacientes e agenda passam a vir do MySQL da VPS Hostinger.
NEXT_PUBLIC_DEMO_MODE=true

# Origem HTTPS do backend permanente. Na Vercel, encaminha apenas namespaces
# de API para a aplicação na VPS Hostinger; páginas e assets continuam servidos pela
# própria Vercel. Deixe vazio no desenvolvimento local.
BACKEND_ORIGIN=

# ---------------------------------------------------------------------------
# Login da equipe
# ---------------------------------------------------------------------------
# Obrigatório fora da demonstração. Gere o segredo com:
#   openssl rand -hex 32
AUTH_SESSION_SECRET=
# JSON server-side. Cada entrada usa um hash scrypt no formato
# scrypt$<salt>$<hash>. Gere hashes com `hashPassword` em
# apps/web/src/server/auth.ts; nunca use NEXT_PUBLIC_ para credenciais.
# Exemplo:
# AUTH_USERS_JSON=[{"email":"admin@clinica.com","userId":"usr-coordenacao","organizationId":"org-viver-mais","passwordHash":"scrypt$..."}]
AUTH_USERS_JSON=

# Credenciais conhecidas de demonstração existem somente quando NODE_ENV não é
# production. Produção exige AUTH_USERS_JSON ou senha_hash no MySQL.

# ---------------------------------------------------------------------------
# MySQL — VPS Hostinger (rede Docker privada)
# ---------------------------------------------------------------------------
# Em produção MYSQL_HOST=mysql é resolvido somente na rede Docker da VPS.
# Não expor a porta 3306 em firewall, Caddy ou load balancer. Para desenvolvimento,
# use o MySQL descartável em infra/mysql/docker-compose.dev.yml, na porta 3307.
DATABASE_URL=

# Banco próprio desta aplicação, criado por infra/mysql/000_criar_banco_clinica.sh.
# Mesma instância, mesmas credenciais e mesmo TLS do Sponteiro — mas nenhum dado
# compartilhado: o banco `viver_mais` de lá foi exercitado com dados de teste.
#
# Alternativa a DATABASE_URL, quando for preferível separar os campos.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=viver_mais_clinica

# Opcional para uma instalação MySQL com TLS. Na VPS atual, a comunicação entre
# web e mysql fica na rede Docker privada; se habilitar TLS, mantenha o PEM fora
# do repositório e com leitura restrita ao serviço.
MYSQL_SSL_CA=
MYSQL_SSL_CA_FILE=

# Instituição atendida por esta instalação. Determina o `instituicoes.id`; não
# é preferência de nome, é a escolha do tenant.
ORGANIZATION_SLUG=viver-mais-psicologia

# Organização dentro da instituição. Tem precedência sobre
# NEXT_PUBLIC_ORGANIZATION_ID na escolha de `organizacao_ref` e, ao contrário
# dele, não vaza para o bundle do cliente. Default: org-viver-mais.
ORGANIZATION_ID=

# ---------------------------------------------------------------------------
# Migrações de esquema
# ---------------------------------------------------------------------------
# Credencial ADMINISTRATIVA, usada só por `npm run db:migrate`. Separada de
# propósito: `viver_mais_app` tem apenas DML (SELECT/INSERT/UPDATE/DELETE), de
# modo que um comprometimento da aplicação não alcance o esquema.
#
# Desenvolvimento, contra o MySQL local de infra/mysql/docker-compose.dev.yml:
#   npm run db:up
#   MYSQL_ADMIN_URL=mysql://root:dev-root-local@127.0.0.1:3307/viver_mais_clinica npm run db:migrate
MYSQL_ADMIN_URL=

# ---------------------------------------------------------------------------
# Contexto do ator (provisório — não é autenticação)
# ---------------------------------------------------------------------------
# Enviados como X-Organization-Id / X-User-Id. Com MySQL configurado, precisam
# corresponder a um vínculo ativo em clinica_membros, senão tudo responde 403.
NEXT_PUBLIC_ORGANIZATION_ID=org-demo
NEXT_PUBLIC_ACTOR_USER_ID=user-demo

# ---------------------------------------------------------------------------
# Diagnóstico de infraestrutura
# ---------------------------------------------------------------------------
# Protege o endpoint de diagnóstico de infraestrutura. Gerar com: openssl rand -hex 32
CRON_SECRET=

# Worker interno que chama a varredura idempotente de SLA. Gere outro segredo,
# distinto de CRON_SECRET: openssl rand -hex 32. Sem ele o worker não inicia.
SLA_SWEEP_TOKEN=
# Intervalo em segundos; o mínimo efetivo é 60. Cinco minutos é suficiente
# para um SLA de 24h e limita chamadas em caso de indisponibilidade.
SLA_SWEEP_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# Integrações (server-side; nunca com prefixo NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# URL interna da Evolution API. O backend lê exatamente este nome; se estiver
# vazia, os fluxos de WhatsApp ficam indisponíveis e respondem 503, sem envio.
# Na VPS, use o hostname da rede Docker da Evolution, nunca uma URL pública.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Nome exato da instância pareada na Evolution API.
EVOLUTION_INSTANCE_NAME=

# Token do webhook da Evolution (o mesmo valor que vai na query de
# WEBHOOK_GLOBAL_URL, em infra/evolution/env.example). É por este webhook que
# chegam as respostas CONTATO e ENCAMINHAR do psicólogo.
#
# **Vazio desliga a rota**, que passa a recusar todo evento com 401. É
# deliberado: sem o token, quem descobrisse a URL poderia confirmar contato ou
# devolver paciente à fila em nome de um profissional.
# Gerar com: openssl rand -hex 32
EVOLUTION_WEBHOOK_TOKEN=

# Destinatários autorizados a receber WhatsApp, separados por vírgula.
#
# **Lista vazia bloqueia todo envio.** É o padrão, e é deliberado: esquecer de
# configurar precisa resultar em nenhuma mensagem, não em todas. Mensagem
# enviada é irreversível, e um número digitado errado é o telefone de um
# desconhecido recebendo conteúdo de uma clínica de psicologia.
#
# Enquanto a operação está em piloto, apenas dois contatos estão liberados — um
# de profissional e um de paciente. Os números reais vão no .env, que não é
# versionado. Não coloque telefone de pessoa aqui.
WHATSAPP_ALLOWED_NUMBERS=

# Números da coordenação que recebem somente alertas operacionais de
# transbordo (protocolo e profissionais; nunca dados do paciente). Cada número
# também precisa constar em WHATSAPP_ALLOWED_NUMBERS; vazio desliga o alerta.
WHATSAPP_COORDINATION_NUMBERS=

# Caminho do snapshot do modo demonstração.
# Padrão: .demo-state/application-state.json na raiz do processo.
# Ignorado quando o MySQL está configurado.
DEMO_STATE_FILE=
