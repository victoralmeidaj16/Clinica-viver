# O projeto inicia em modo demonstração até que autenticação,
# persistência e integrações reais sejam configuradas.
NEXT_PUBLIC_DEMO_MODE=true

# Configurações exclusivamente server-side (não usar prefixo NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
AI_PROVIDER_API_KEY=

# Caminho do snapshot de estado da demonstração.
# Padrão: .demo-state/application-state.json na raiz do processo.
DEMO_STATE_FILE=
