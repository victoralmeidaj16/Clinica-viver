# Dependencies
node_modules/

# Next.js
.next/
out/

# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/

# TypeScript
*.tsbuildinfo

# Tests and coverage
coverage/

# Environment and secrets
.env
.env.*
!.env.example

# Certificados e chaves — a CA do MySQL da OCI e as chaves SSH da VM ficam
# fora do repositório, no Mac e na própria VM.
*.pem
*.key
!*.pub

# Certificado A1 da ICP-Brasil (NFS-e). Um .pfx carrega a chave privada da
# empresa: quem tem o arquivo e a senha assina nota fiscal em nome do CNPJ.
# Commitar uma vez basta para que ele fique no histórico para sempre, e a
# única correção é revogar o certificado na AC e comprar outro.
*.pfx
*.p12
*.cer
*.crt

# Logs
*.log
npm-debug.log*

# OS and editors
.DS_Store
.idea/
.vscode/

# Clinical data must never be committed
clinical-data/
uploads/
recordings/
transcriptions/

# Estado local de demonstração (contém dados de sessões da demo)
.demo-state/
.vercel
