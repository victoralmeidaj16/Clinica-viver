{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "regions": ["gru1"],
  "rewrites": [
    {
      "source": "/api/application/:path*",
      "destination": "https://app.clinicavivermais.cloud/api/application/:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://app.clinicavivermais.cloud/api/auth/:path*"
    },
    {
      "source": "/api/infra/:path*",
      "destination": "https://app.clinicavivermais.cloud/api/infra/:path*"
    },
    {
      "source": "/api/certificados/:path*",
      "destination": "https://app.clinicavivermais.cloud/api/certificados/:path*"
    },
    {
      "source": "/api/public/certificados/:path*",
      "destination": "https://app.clinicavivermais.cloud/api/public/certificados/:path*"
    }
  ]
}
