# Modelo de configuração do Evolution API para a clínica.
#
# Copiar para .env e preencher os segredos. O .env real NÃO vai para o Git —
# o padrão ".env*" já está no .gitignore da raiz.
#
# O .env.example oficial do projeto tem mais de 400 linhas. Aqui ficam apenas as
# variáveis que usamos, com os padrões já ajustados para contexto de saúde.
# O que não está listado permanece no padrão da imagem.

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
SERVER_TYPE=http
SERVER_PORT=8080
# URL pela qual a própria API se referencia. Em rede interna, o nome do serviço.
SERVER_URL=http://evolution:8080

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
# Gerar com: openssl rand -hex 32
# Nunca reaproveitar a chave de exemplo da documentação oficial — ela é pública
# e é a primeira coisa que um scan tenta.
AUTHENTICATION_API_KEY=
# Não devolver as chaves das instâncias na listagem.
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# ---------------------------------------------------------------------------
# Banco do Evolution (exclusivo dele, não é o MySQL clínico da VPS)
# ---------------------------------------------------------------------------
POSTGRES_USER=evolution
POSTGRES_PASSWORD=
POSTGRES_DB=evolution

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:SENHA_AQUI@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=viver_mais_clinica

# --- Minimização de dados: a decisão mais importante deste arquivo ----------
# Os padrões do Evolution persistem TUDO — mensagens, contatos, conversas e
# histórico. Em clínica, o que o paciente responde pode conter conteúdo
# sensível, e persistir isso num banco secundário cria uma segunda base de
# dado de saúde fora das regras de sigilo da seção 9 do plano.
#
# Guardamos apenas o necessário para a sessão existir. O que interessa à
# operação (envio, status, opt-out) é gravado por nós em clinica_mensagens,
# com auditoria e retenção definidas.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# Não apagar instância automaticamente em desconexão — perder a instância é
# perder o pareamento.
DEL_INSTANCE=false

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=viver_mais_clinica
CACHE_REDIS_TTL=604800
# Instâncias ficam no banco, não no Redis: mais durável em reinício.
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ---------------------------------------------------------------------------
# Webhook — o que a aplicação precisa ouvir
# ---------------------------------------------------------------------------
WEBHOOK_GLOBAL_ENABLED=true
# Rota da aplicação. O token vai na query porque o webhook global da v2 não
# garante cabeçalho customizado; a rota também aceita `x-evolution-token`.
# Gerar com: openssl rand -hex 32
# O mesmo valor precisa estar em EVOLUTION_WEBHOOK_TOKEN no .env da aplicação.
WEBHOOK_GLOBAL_URL=https://SUBDOMINIO_DA_VIVER/api/clinica/whatsapp/webhook?token=TOKEN_DO_WEBHOOK
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# Só os eventos que têm uso. Todo evento a mais é dado de paciente trafegando
# sem motivo. Cada um tem um consumidor na rota do webhook:
#   qrcode/connection  -> monitor de sessão na rota de diagnóstico de infraestrutura
#   send.message*      -> status em clinica_mensagens
#   messages.upsert    -> respostas CONTATO / ENCAMINHAR do psicólogo e opt-out
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_SEND_MESSAGE=true
WEBHOOK_EVENTS_SEND_MESSAGE_UPDATE=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
# Confirmação de entrega e leitura chega como messages.update na v2. Sem ele,
# a mensagem fica parada em "enviada" e o limite de tempo acusa pendência que
# não existe. A rota aceita os dois nomes de evento.
WEBHOOK_EVENTS_MESSAGES_UPDATE=true

WEBHOOK_EVENTS_APPLICATION_STARTUP=false
WEBHOOK_EVENTS_MESSAGES_SET=false
WEBHOOK_EVENTS_MESSAGES_EDITED=false
WEBHOOK_EVENTS_MESSAGES_DELETE=false
WEBHOOK_EVENTS_CONTACTS_SET=false
WEBHOOK_EVENTS_CONTACTS_UPSERT=false
WEBHOOK_EVENTS_CONTACTS_UPDATE=false
WEBHOOK_EVENTS_PRESENCE_UPDATE=false
WEBHOOK_EVENTS_CHATS_SET=false
WEBHOOK_EVENTS_CHATS_UPSERT=false
WEBHOOK_EVENTS_CHATS_UPDATE=false
WEBHOOK_EVENTS_CHATS_DELETE=false
WEBHOOK_EVENTS_GROUPS_UPSERT=false
WEBHOOK_EVENTS_GROUPS_UPDATE=false
WEBHOOK_EVENTS_GROUP_PARTICIPANTS_UPDATE=false
WEBHOOK_EVENTS_LABELS_EDIT=false
WEBHOOK_EVENTS_LABELS_ASSOCIATION=false
WEBHOOK_EVENTS_CALL=false
WEBHOOK_EVENTS_TYPEBOT_START=false
WEBHOOK_EVENTS_TYPEBOT_CHANGE_STATUS=false

# Reentrega com backoff. Deixar o Evolution insistir evita perder confirmação
# de entrega num reinício da aplicação.
WEBHOOK_REQUEST_TIMEOUT_MS=60000
WEBHOOK_RETRY_MAX_ATTEMPTS=10
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=5
WEBHOOK_RETRY_USE_EXPONENTIAL_BACKOFF=true
WEBHOOK_RETRY_MAX_DELAY_SECONDS=300

# ---------------------------------------------------------------------------
# Sessão
# ---------------------------------------------------------------------------
# Nome que aparece em "Dispositivos conectados" no celular da clínica.
# Deixar explícito ajuda a recepção a não desconectar por engano.
CONFIG_SESSION_PHONE_CLIENT=Viver Mais Clinica
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# ---------------------------------------------------------------------------
# Logs, telemetria e CORS
# ---------------------------------------------------------------------------
# Sem DEBUG/VERBOSE: em nível alto o Baileys registra conteúdo de mensagem,
# o que colide com a regra de "nenhum dado clínico em log".
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
LOG_COLOR=false

# Não enviar telemetria de uma instância que trafega dado de paciente.
TELEMETRY_ENABLED=false

# A API só é consumida servidor-a-servidor; não há navegador chamando.
CORS_ORIGIN=http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

LANGUAGE=en
